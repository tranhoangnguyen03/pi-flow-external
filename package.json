    "CONTEXT.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "workflow",
    "multi-agent",
    "codex",
    "claude",
