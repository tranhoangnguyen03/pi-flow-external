{
  "name": "@tranhoangnguyen0310/pi-flow-external",
  "version": "1.8.0-external.1",
  "description": "External Claude Code, Codex CLI, and Antigravity delegation for pi.",
  "type": "module",
  "main": "./index.ts",
  "exports": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "scripts/field-report.mjs",
    "docs/field-testing.md",
